# 로컬 서버
APP_HOST=127.0.0.1
APP_PORT=8765
APP_RELOAD=false
OPEN_BROWSER=true
DATABASE_PATH=data/hiseoul_companies.db

# 하이서울기업 원본 WebMethod
SOURCE_BASE_URL=https://hiseoul.sba.kr
SOURCE_LIST_PATH=/Pages/AccountList.aspx/GetData
SOURCE_DETAIL_PATH=/Pages/AccountDetail.aspx/GetData
SOURCE_COOKIE=lang=KOR

# 원본 사이트가 별도 인증을 요구하게 될 때만 입력
SOURCE_API_KEY=
SOURCE_API_KEY_HEADER=X-API-Key
SOURCE_HEADERS_JSON={}

# 통신·호출 제한
SOURCE_VERIFY_TLS=true
SOURCE_TIMEOUT_SECONDS=45
SOURCE_MAX_CONCURRENCY=4
SOURCE_MAX_DETAILS=100
SOURCE_BULK_MAX_DETAILS=2000
SOURCE_REQUEST_DELAY_MS=80
ALLOW_EMPTY_SOURCE_SEARCH=false
